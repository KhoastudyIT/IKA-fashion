# Chép tệp này thành .env rồi điền giá trị thật. BẮT BUỘC phải có .env thì
# `docker compose up` mới chạy — JWT_SECRET và ADMIN_PASSWORD không còn giá trị
# mặc định trong repo nữa.
#
#   cp .env.example .env
#
# Tệp .env đã nằm trong .gitignore, không commit lên git.

# PostgreSQL
POSTGRES_PASSWORD=doi-mat-khau-nay

# Backend
# Sinh một chuỗi ngẫu nhiên rồi dán vào đây, ví dụ:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
CORS_ORIGIN=http://localhost:3000

# Tài khoản quản trị được tạo lần đầu khi seed. Đổi mật khẩu sau lần đăng nhập
# đầu tiên; giá trị ở đây chỉ dùng để khởi tạo.
ADMIN_EMAIL=admin@ika.vn
ADMIN_PASSWORD=

# Trang tài liệu API tại /api-docs — chỉ bật khi cần xem, không để bật lâu dài.
OPENAPI_ENABLED=false

# Frontend (nhúng lúc build — URL backend nhìn từ trình duyệt)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
